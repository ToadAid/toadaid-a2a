{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.toadaid.org/specs/lore-rights-review-request.v0.schema.json",
  "title": "ToadAid Lore Rights Review Request — local packet shape only",
  "description": "Design schema only; this URL is NOT DEPLOYED; a self-submitted packet is never rights proof, a publication grant, or a license. Independent human/legal review mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "source",
    "request",
    "reviewEvidence"
  ],
  "properties": {
    "kind": {
      "const": "toadaid-lore-rights-review-request"
    },
    "schemaVersion": {
      "const": "0.1.0"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "commit",
        "sourceGitBlobSha1",
        "sourceDigest",
        "recordCount"
      ],
      "properties": {
        "repository": {
          "const": "ToadAid/toadaid.github.io"
        },
        "path": {
          "const": "lore/data.json"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceGitBlobSha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "audience",
        "recordIds",
        "fields",
        "purpose"
      ],
      "properties": {
        "operation": {
          "enum": [
            "evaluate_metadata",
            "evaluate_lore_text",
            "evaluate_media_reference",
            "evaluate_media_binary"
          ]
        },
        "audience": {
          "const": "public-agent-native-web"
        },
        "recordIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:-]{3,128}$"
          }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "id",
              "date",
              "title",
              "original",
              "comment",
              "url",
              "img",
              "tags"
            ]
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rightsStatus",
        "permissionEvidenceId",
        "attributionReviewId",
        "privacyReviewId",
        "withdrawalPlanId",
        "humanReviewerAttestationId",
        "mediaReviewId"
      ],
      "properties": {
        "rightsStatus": {
          "enum": [
            "unknown",
            "restricted",
            "disputed",
            "permission_claimed",
            "public_domain_claimed"
          ]
        },
        "permissionEvidenceId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,63}$"
            }
          ]
        },
        "attributionReviewId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,63}$"
            }
          ]
        },
        "privacyReviewId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,63}$"
            }
          ]
        },
        "withdrawalPlanId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,63}$"
            }
          ]
        },
        "humanReviewerAttestationId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,63}$"
            }
          ]
        },
        "mediaReviewId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,63}$"
            }
          ]
        }
      }
    }
  }
}
