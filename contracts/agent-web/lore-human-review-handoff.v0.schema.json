{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toadaid:agent-web:lore-human-review-handoff:v0",
  "title": "ToadAid human review handoff (untrusted local structure; never approval)",
  "description": "DESIGN ONLY. NOT DEPLOYED. Evidence refs are unverified pointers, not reviewer authentication, permissions or legal determinations. No granted/approved/released stage exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "binding",
    "review"
  ],
  "properties": {
    "kind": {
      "const": "toadaid-lore-human-review-handoff"
    },
    "schemaVersion": {
      "const": "0.1.0"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packetSha256",
        "sourceDigest",
        "sourceGitBlobSha1"
      ],
      "properties": {
        "packetSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceGitBlobSha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseRef",
        "stage",
        "decisionChannel",
        "evidenceRefs",
        "objectionCodes"
      ],
      "properties": {
        "caseRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "stage": {
          "enum": [
            "awaiting-independent-review",
            "declined",
            "withdrawn"
          ]
        },
        "decisionChannel": {
          "const": "independent-off-chat-human-process"
        },
        "evidenceRefs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewerIdentityEvidenceRef",
            "reviewerIndependenceEvidenceRef",
            "rightsChainEvidenceRef",
            "scopePermissionEvidenceRef",
            "attributionEvidenceRef",
            "privacyEvidenceRef",
            "withdrawalEvidenceRef",
            "conflictDisclosureEvidenceRef",
            "mediaEvidenceRef"
          ],
          "properties": {
            "reviewerIdentityEvidenceRef": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                }
              ]
            },
            "reviewerIndependenceEvidenceRef": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                }
              ]
            },
            "rightsChainEvidenceRef": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                }
              ]
            },
            "scopePermissionEvidenceRef": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                }
              ]
            },
            "attributionEvidenceRef": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                }
              ]
            },
            "privacyEvidenceRef": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                }
              ]
            },
            "withdrawalEvidenceRef": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                }
              ]
            },
            "conflictDisclosureEvidenceRef": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                }
              ]
            },
            "mediaEvidenceRef": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                }
              ]
            }
          }
        },
        "objectionCodes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SOURCE_IDENTITY",
              "RIGHTS_CHAIN",
              "PERMISSION_SCOPE",
              "ATTRIBUTION",
              "PRIVACY",
              "WITHDRAWAL",
              "CONFLICT_OF_INTEREST",
              "MEDIA_RIGHTS",
              "OTHER"
            ]
          }
        }
      }
    }
  }
}
